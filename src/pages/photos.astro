---
import CleanLayout from '../layouts/CleanLayout.astro';
import BottomNav from '../components/BottomNav.astro';
import { PhotoBack, PhotoShare } from '../components/PhotoControls';

// Datos de las fotos/proyectos
const photos = [
  {
    image: "/img/pink.jpg",
    title: "🏢",
    date: "26 de Julio, 2023",
    location: "Santiago, Chile",
    link: "https://github.com/gioahumada/linktanya",
  },
  {
    image: "/img/lawyer.jpg",
    title: "better call gio",
    date: "15 de Agosto, 2023",
    location: "Valparaíso, Chile",
    link: "https://github.com/gioahumada/tiktokportafolio",
  },
  {
    image: "/img/palm.jpg",
    title: "🔴🟠🟡🟢🔵🟣🟤⚫️⚪️",
    date: "4 de enero de 2023",
    location: "Viña del Mar, Chile",
    link: "https://github.com/gioahumada/linktree",
  },
  {
    image: "/img/scout.jpg",
    title: "2. champagne problems - taylor swift",
    date: "9 de diciembre de 2022",
    location: "Villa Alemana, Chile",
    link: "https://github.com/gioahumada/tiktokportafolio",
  },
];
---

<CleanLayout title="Fotografías" description="Una selección de fotografías y momentos de Giovanni Ahumada." pageKey="photos">
  <PhotoBack client:load />

  <div class="app__photos" id="photos-feed">
    {photos.map((photo, index) => (
      <div class="photo">
        <a href={photo.link} target="_blank">
          <img src={photo.image} class="photo__image" alt={photo.title} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} width="1080" height="1350" />
        </a>

        <div class="photoSidebar">
          <PhotoShare client:visible />
        </div>

        <div class="photoFooter">
          <div class="photoFooter__text">
            <h3>{photo.title}</h3>
            <p class="photoFooter__description">{photo.date}</p>
            <div class="photoFooter__ticker">
              <span class="material-symbols-outlined photoFooter__icon">location_on</span>
              <marquee>{photo.location}</marquee>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="desktop-photo-controls">
    <PhotoShare client:visible />
    <span class="photo-controls-separator" aria-hidden="true"></span>
    <button type="button" class="lg-glass lg-button" data-photo-step="-1" aria-label="Foto anterior" aria-controls="photos-feed" disabled>
      <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_up</span>
    </button>
    <button type="button" class="lg-glass lg-button" data-photo-step="1" aria-label="Foto siguiente" aria-controls="photos-feed">
      <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
    </button>
  </div>
  <div class="desktop-photo-nav"><BottomNav theme="dark" defer /></div>
</CleanLayout>

<style>
/* Botón de regreso */
:global(.back-button) {
  position: fixed;
  top: calc(20px + env(safe-area-inset-top, 0px));
  left: calc(20px + env(safe-area-inset-left, 0px));
  z-index: 1000;
  --lg-glass: rgb(0 0 0 / 0.55);
  --lg-edge: rgb(255 255 255 / 0.2);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  text-decoration: none;
  transition: transform 0.3s ease;
}

:global(.back-button:hover) {
  transform: scale(1.1);
}

:global(.back-button a) {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

:global(.back-button .material-symbols-outlined) {
  font-size: var(--text-lg);
}

.app__photos {
  position: relative;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  overflow-y: scroll;
  overflow-x: hidden;
  scroll-snap-type: y mandatory;
  background-color: black;
  -ms-overflow-style: none;
  scrollbar-width: none;
  border-radius: 20px;
}

.app__photos::-webkit-scrollbar {
  display: none;
}

.photo {
  position: relative;
  width: 100%;
  height: 100%;
  scroll-snap-align: start;
  overflow: hidden;
}

.photo__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70%;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(0, 0, 0, 0.5) 30%,
    rgba(0, 0, 0, 0.8) 100%
  );
  pointer-events: none;
}

.photoSidebar {
  position: absolute;
  top: 45%;
  right: 10px;
  z-index: 2;
}

.photoSidebar .material-symbols-outlined {
  font-size: var(--text-lg);
  cursor: pointer;
}

.photoSidebar_button {
  padding: 0.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.photoSidebar_button p {
  font-size: var(--text-xs);
}

.photoFooter {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2rem 1.5rem calc(2rem + env(safe-area-inset-bottom, 0px));
  z-index: 2;
}

.photoFooter__text {
  max-width: 100%;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.photoFooter__text h3 {
  font-size: var(--text-heading);
  font-weight: 600;
  margin-bottom: 0.75rem;
  white-space: normal;
  line-height: 1.5;
}

.photoFooter__description {
  font-size: var(--text-sm);
  margin-bottom: 0.75rem;
  white-space: normal;
  line-height: 1.4;
  opacity: 0.9;
}

.photoFooter__ticker {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--text-sm);
  margin-top: 0.5rem;
}

.photoFooter__icon {
  font-size: var(--text-base);
  color: white;
}

.photoFooter__ticker marquee {
  flex: 1;
  opacity: 0.9;
}

@media (max-width: 768px) {
  .app__photos {
    max-width: 100%;
    border-radius: 0;
  }

  .photo {
    height: calc(100vh - env(safe-area-inset-bottom, 0px));
    height: calc(100dvh - env(safe-area-inset-bottom, 0px));
  }

  .photoFooter {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.7) 30%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .photoFooter__text h3 {
    font-size: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .photoFooter__description {
    font-size: var(--text-base);
    margin-bottom: 0.5rem;
  }

  .photoFooter__ticker {
    font-size: var(--text-base);
  }

  .photo::after {
    height: 75%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(0, 0, 0, 0.6) 30%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }
}

.desktop-photo-nav,
.desktop-photo-controls {
  display: none;
}

@media (min-width: 769px) {
  :global(body[data-page="photos"]) {
    --photo-nav-space: calc(2rem + 56px);
    --photo-width: min(30rem, 70vw, (100dvh - var(--photo-nav-space) - 32px) * 313 / 445);
    background: radial-gradient(ellipse at 50% 35%, #202023 0%, #111113 48%, #080809 100%);
  }

  .app__photos {
    width: var(--photo-width);
    height: auto;
    aspect-ratio: 313 / 445;
    border-radius: 20px;
    top: calc(var(--photo-nav-space) / -2);
  }

  .photo:not(:last-child) { margin-bottom: 2px; }
  .photoSidebar { display: none; }

  .desktop-photo-nav { display: contents; }
  .desktop-photo-nav :global(.bottom-nav-container) { bottom: 2rem; }

  .desktop-photo-controls {
    position: fixed;
    left: calc(50% + var(--photo-width) / 2 + 20px);
    top: calc((100dvh - var(--photo-nav-space)) / 2);
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .photo-controls-separator {
    width: 24px;
    height: 1px;
    align-self: center;
    background: rgb(255 255 255 / 0.2);
  }

  .desktop-photo-controls button {
    width: 40px;
    padding: 0;
    border-radius: 50%;
    --lg-glass: rgb(255 255 255 / 0.15);
    --lg-glass-active: rgb(255 255 255 / 0.25);
    color: white;
  }
}

/* Nuevo estilo para el botón de compartir */
:global(.share-button) {
  --lg-glass: rgb(255 255 255 / 0.2);
  --lg-glass-active: rgb(255 255 255 / 0.4);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.3s ease;
}

:global(.share-button:hover) {
  transform: scale(1.1);
}

:global(.share-button .material-symbols-outlined) {
  color: white;
  font-size: var(--text-lg);
}
</style>

<script>
  import { onPageLoad } from "../lib/spa-lifecycle";

  function shareContent(title: string, text: string, url: string) {
    if (navigator.share) {
      navigator.share({
        title: title,
        text: text,
        url: url
      })
      .catch((error) => console.log('Error sharing:', error));
    } else {
      const dummy = document.createElement('input');
      document.body.appendChild(dummy);
      dummy.value = url;
      dummy.select();
      document.execCommand('copy');
      document.body.removeChild(dummy);
      alert('¡Enlace copiado al portapapeles!');
    }
  }

  onPageLoad(() => {
    const feed = document.getElementById('photos-feed');
    const controls = [...document.querySelectorAll<HTMLButtonElement>('[data-photo-step]')];
    const updateControls = () => {
      if (!feed) return;
      controls.forEach((button) => {
        button.disabled = Number(button.dataset.photoStep) < 0
          ? feed.scrollTop <= 1
          : feed.scrollTop + feed.clientHeight >= feed.scrollHeight - 1;
      });
    };
    const scrollPhoto = (event: MouseEvent) => {
      if (!feed) return;
      const step = Number((event.currentTarget as HTMLButtonElement).dataset.photoStep);
      const photos = [...feed.querySelectorAll<HTMLElement>('.photo')];
      const index = Math.round(feed.scrollTop / feed.clientHeight) + step;
      if (photos[index]) feed.scrollTo({ top: photos[index].offsetTop, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    controls.forEach((button) => button.addEventListener('click', scrollPhoto));
    feed?.addEventListener('scroll', updateControls, { passive: true });
    updateControls();

    const handleClick = (e: MouseEvent) => {
      const button = (e.target as Element).closest('.share-button') as HTMLElement | null;
      if (!button) return;
      e.preventDefault();
      const photo = button.closest('.photo') ?? feed?.querySelectorAll('.photo')[Math.round(feed.scrollTop / feed.clientHeight)];
      if (!photo) return;
      const titleEl = photo.querySelector('h3');
      const descEl = photo.querySelector('.photoFooter__description');
      const linkEl = photo.querySelector('a');
      if (!titleEl || !descEl || !linkEl) return;
      shareContent(
        titleEl.textContent || '',
        descEl.textContent || '',
        linkEl.getAttribute('href') || ''
      );
    };
    document.addEventListener('click', handleClick);
    return () => {
      document.removeEventListener('click', handleClick);
      controls.forEach((button) => button.removeEventListener('click', scrollPhoto));
      feed?.removeEventListener('scroll', updateControls);
    };
  });
</script>

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
