---
import Layout from '../layouts/Layout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import ProjectList from '../components/ProjectList.astro';
---

<Layout title="Giovanni Ahumada">
  <main>
    <div class="quote-container">
      <blockquote>
        "Hola, soy Giovanni Ahumada, estudiante de Ingeniería Informática en la Pontificia Universidad Catolica de Valparaiso. Me apasiona la tecnología y la programación, y estoy comprometido a aprender y crecer en este campo."
      </blockquote>
    </div>

    <div class="bento-wrapper">
      <BentoGrid />
    </div>
    
    <div class="section-divider">
      <h2>Proyectos</h2>
    </div>
    
    <div class="projects-wrapper">
      <ProjectList />
    </div>

    <div class="repo-link-container">
      <br>
      <p>¿Interesado en ver cómo está construida esta página? Revisa el <a href="https://github.com/gioahumada/gioahumada-page" target="_blank" rel="noopener noreferrer">repositorio en GitHub</a>.</p>
      <br>
      <br>
    </div>
  </main>
</Layout>

<script>
  import { animate, stagger } from "motion";

  // Premium easing (Apple-like smooth deceleration)
  const smoothEasing = [0.16, 1, 0.3, 1];
  const duration = 1.2;

  // Initial state for all animated elements
  const elements = [
    ".quote-container",
    ".bento-wrapper",
    ".section-divider",
    ".project-card",
    ".repo-link-container"
  ];

  // Hide elements immediately to prepare for animation
  elements.forEach(selector => {
    document.querySelectorAll(selector).forEach(el => {
      (el as HTMLElement).style.opacity = "0";
      (el as HTMLElement).style.filter = "blur(10px)";
      (el as HTMLElement).style.transform = "translateY(30px)";
    });
  });

  // Animation sequence
  animate(
    ".quote-container", 
    { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" } as any, 
    { duration: duration, ease: smoothEasing } as any
  );

  animate(
    ".bento-wrapper", 
    { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" } as any, 
    { delay: 0.2, duration: duration, ease: smoothEasing } as any
  );

  animate(
    ".section-divider", 
    { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" } as any, 
    { delay: 0.3, duration: duration, ease: smoothEasing } as any
  );

  // Stagger individual project cards with a rich cascade
  animate(
    ".project-card", 
    { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" } as any, 
    { 
      delay: stagger(0.15, { start: 0.4 } as any), 
      duration: duration, 
      ease: smoothEasing 
    } as any
  );

  animate(
    ".repo-link-container", 
    { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" } as any, 
    { delay: 1.0, duration: duration, ease: smoothEasing } as any
  );
</script>

<style>
.section-divider {
  max-width: 1200px;
  margin: 4rem auto 2rem;
  padding: 0 1rem;
  text-align: center;
}

.section-divider h2 {
  font-size: var(--text-lg);
  font-weight: 500;
  letter-spacing: -0.02em;
}

.quote-container {
  max-width: 800px;
  margin: 3rem auto;
  padding: 0 1rem;
  text-align: center;
}

blockquote {
  font-size: var(--text-base);
  color: var(--primary-color);
  line-height: 1.6;
  max-width: 300px;
  margin: 0 auto;
  text-align: left;
}

blockquote footer {
  margin-top: 0.5rem;
  font-size: var(--text-base);
  color: var(--text-2);
  font-style: normal;
}

.repo-link-container {
  max-width: 800px;
  margin: 4rem auto 2rem;
  padding: 0 1rem;
  text-align: center;
  font-size: var(--text-base);
}

.repo-link-container a {
  color: var(--primary-color);
  text-decoration: underline;
  transition: opacity 0.2s ease;
}

.repo-link-container a:hover {
  opacity: 0.8;
}

@media (max-width: 768px) {
  .quote-container {
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  blockquote {
    font-size: var(--text-sm);
    max-width: 100%;
  }

  .section-divider {
    margin: 3rem auto 1.5rem;
  }
}

@media (max-width: 480px) {
  .quote-container {
    margin: 1.5rem auto;
    padding: 0 1rem;
  }

  blockquote {
    font-size: var(--text-xs);
  }

  .section-divider h2 {
    font-size: var(--text-base);
  }
}

.opacity-0 {
  opacity: 0;
}

.translate-y-4 {
  transform: translateY(20px);
}
</style>
