---
import Layout from '../layouts/Layout.astro';
import IntroQuote from '../components/IntroQuote.astro';
import CvButtons from '../components/CvButtons';
import SocialLinks from '../components/SocialLinks';
import TypewriterTitle from '../components/TypewriterTitle.astro';
import DitherBottom from '../components/DitherBottom.astro';
import { profile } from '../data/resume';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: profile.email,
  url: profile.site,
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.school },
  sameAs: profile.contact.flat().map((l) => l.url).filter((u): u is string => !!u && u.startsWith('http') && u !== profile.site),
};
---

<Layout title="Résumé - Giovanni Ahumada" description="Descarga mi CV en versión visual o en versión compatible con sistemas ATS." pageKey="resume">
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <link rel="alternate" type="application/json" href="/resume.json" title="CV en JSON" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="resume-main">
    <TypewriterTitle words={["Résumé", "Currículum", "Curriculum vitæ"]} />
    <IntroQuote text="Estoy abierto a nuevas oportunidades: prácticas, proyectos y equipos donde pueda construir, aprender y aportar. Si algo de lo que hago te hace sentido, conversemos." />

    <div class="resume-content">
      <CvButtons client:load />
    </div>
    <DitherBottom>
      <SocialLinks client:idle />
    </DitherBottom>
  </main>
</Layout>

<style is:global>
  .resume-main {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 112vh;
  }

  .wrapper {
    overflow-x: clip;
  }

  .resume-content {
    position: relative;
    z-index: 1;
  }

  .cv-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cv-social-label {
    font-size: var(--text-sm);
    color: var(--primary-color);
  }

  .cv-social-dock {
    display: flex;
    gap: 0.25rem;
  }

  .cv-social-dock a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--primary-color);
    transition: transform 0.2s ease;
  }

  .cv-social-dock a:hover {
    transform: scale(1.12);
  }

  .cv-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem auto 0;
    padding: 0 1rem;
  }

  .cv-robot {
    margin-top: 1.5rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--primary-color);
  }

  .cv-robot .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cv-robot-who {
    display: inline-block;
    animation: cv-who-in 0.4s ease both;
  }

  @keyframes cv-who-in {
    from { opacity: 0; transform: translateY(0.4em); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-robot-who { animation: none; }
  }

  .cv-robot-link {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .cv-robot-link:hover:not(:disabled) {
    opacity: 0.7;
  }

  .cv-robot-link:disabled {
    opacity: 0.5;
  }

  .cv-status {
    min-height: 1.5rem;
    margin-top: 1rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--primary-color);
  }
</style>
