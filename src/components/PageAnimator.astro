<script>
  import { playPageAnimation, preparePageAnimation } from "../lib/page-animations";

  const getPageKey = (doc: Document = document): string | undefined =>
    doc.body?.dataset?.page;

  document.addEventListener("astro:before-swap", (event) => {
    const e = event as any;
    const newDoc = e.newDocument as Document | undefined;
    if (!newDoc) return;
    preparePageAnimation(newDoc, getPageKey(newDoc));
  });

  document.addEventListener("astro:page-load", () => {
    playPageAnimation(getPageKey());
  });
</script>
