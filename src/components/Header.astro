---
import '../styles/header.css';
---

<header class="header" id="main-header">
  <nav class="nav-container">
    <div class="brand">
      <div class="logo-container">
        <a href="/"><img src="/logo.png" alt="Logo" class="logo-image" /></a>
      </div>
      <div class="brand-text">
        <h1 class="name">Giovanni Ahumada</h1>
        <p class="position">Estudiante de Ingeniería Informática</p>
      </div>
    </div>
    <div class="nav-links">
      <a href="/resume" class="nav-link">Resumé</a>
    </div>
  </nav>
</header>

<script>
  import { onPageLoad } from "../lib/spa-lifecycle";

  onPageLoad(() => {
    const header = document.getElementById('main-header');
    if (!header) return;

    const handleScroll = () => {
      if (window.scrollY > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    return () => window.removeEventListener('scroll', handleScroll);
  });
</script>