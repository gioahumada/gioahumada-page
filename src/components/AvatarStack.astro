---
/**
 * Pila de avatares superpuestos. Reutilizable.
 * Cada persona puede traer `src` (imagen propia) o `github` (usuario): en ese caso
 * se usa el avatar público de GitHub (https://github.com/<usuario>.png), sin API key.
 * Si la imagen no carga, queda un círculo con las iniciales.
 */
export interface Person {
  name: string;
  github?: string;
  src?: string;
  href?: string;
}

interface Props {
  people: Person[];
  /** Tamaño del avatar: cualquier medida CSS. `1.2em` lo iguala al texto. */
  size?: string;
  /** Máximo de avatares visibles (por defecto todos); el resto se resume en "+N". */
  max?: number;
  /** Fracción del avatar que queda tapada por el siguiente (0–0.8). */
  overlap?: number;
  /** Se inserta dentro de un texto en lugar de ocupar su propia línea. */
  inline?: boolean;
  class?: string;
}

const { people, size = '2.25rem', max = Infinity, overlap = 0.35, inline = false, class: className } = Astro.props;

const shown = people.slice(0, max);
const rest = people.length - shown.length;

// Resolución en px reales para que se vea nítido en pantallas retina.
const pixels = 160;
const srcOf = (p: Person) =>
  p.src ?? (p.github ? `https://github.com/${encodeURIComponent(p.github)}.png?size=${pixels}` : undefined);
const hrefOf = (p: Person) => p.href ?? (p.github ? `https://github.com/${p.github}` : undefined);
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
---

<span
  class:list={['avatar-stack', { inline }, className]}
  style={`--size:${size};--overlap:${overlap}`}
  role="list"
  aria-label={people.map((p) => p.name).join(', ')}
>
  {shown.map((p, i) => {
    const src = srcOf(p);
    const href = hrefOf(p);
    const Tag = href ? 'a' : 'span';
    return (
      <Tag
        class="avatar"
        role="listitem"
        title={p.name}
        style={`z-index:${shown.length - i}`}
        {...(href ? { href, target: '_blank', rel: 'noopener noreferrer', 'aria-label': p.name } : {})}
      >
        <span class="initials" aria-hidden="true">{initials(p.name)}</span>
        {src && (
          <img
            src={src}
            alt=""
            width={pixels}
            height={pixels}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.remove()"
          />
        )}
      </Tag>
    );
  })}
  {rest > 0 && <span class="avatar more" role="listitem" style="z-index:0">+{rest}</span>}
</span>

<style>
  .avatar-stack {
    display: flex;
    align-items: center;
    width: fit-content;
    margin: 1rem 0;
    /* espacio para el anillo y el hover */
    padding: 3px 0 3px 3px;
  }

  .avatar-stack.inline {
    display: inline-flex;
    /* como un emoji: no debe alterar la altura de la línea */
    margin: -1em 0.05em -1em 0.25em;
    padding: 0;
    /* centra el avatar sobre la altura de las letras (centro ≈ 0.88em sobre la línea base) */
    vertical-align: calc(var(--size) * -0.5 + 0.88em);
  }

  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    overflow: hidden;
    background: #e8e8e6;
    color: #4a4a4a;
    text-decoration: none;
    /* Anillo del color de la página: recorta el avatar que queda debajo */
    box-shadow: 0 0 0 max(1.5px, calc(var(--size) * 0.07)) var(--background-color, #fff);
  }

  /* Cada avatar queda "comido" por el anterior (el de la izquierda va encima). */
  .inline .avatar {
    box-shadow: none;
  }

  .avatar + .avatar {
    margin-left: calc(var(--size) * var(--overlap) * -1);
  }

  .initials {
    font-size: calc(var(--size) * 0.36);
    font-weight: 600;
    line-height: 1;
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* el contenido markdown da estilo global a <img>; aquí no aplica */
    margin: 0 !important;
    max-width: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .avatar.more {
    background: #1a1a1a;
    color: #fff;
  }
</style>
