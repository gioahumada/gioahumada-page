---
import GlassNavigation from './GlassNavigation';

interface Props { theme?: 'light' | 'dark'; defer?: boolean }
const { theme = 'light', defer = false } = Astro.props;
---
<div class="bottom-nav-container" data-theme={theme}>
  {defer ? <GlassNavigation pathname={Astro.url.pathname} client:visible /> : <GlassNavigation pathname={Astro.url.pathname} client:idle />}
</div>

<style>
  .bottom-nav-container {
    position: fixed;
    bottom: 2rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
  }
  @supports (-webkit-touch-callout: none) {
    .bottom-nav-container { bottom: 0.75rem; }
  }
  .bottom-nav-container :global(.dock-controls),
  .bottom-nav-container :global(.dock-social-menu) {
    /* Liquid glass: poco desenfoque y lente profunda para que se note la refracción */
    --lg-blur: 6px;
    --lg-glass: rgb(255 255 255 / 0.28);
    --lg-bezel: 18px;
    --lg-thickness: 22px;
    --lg-refraction: 1.6;
    --lg-rim-saturation: 1.8;
    --lg-edge: rgb(0 0 0 / 0.14);
    --lg-drop: rgb(0 0 0 / 0.14);
    box-shadow:
      inset 0 0 0 0.5px var(--lg-edge),
      0 8px 24px rgb(0 0 0 / 0.1),
      0 1px 3px var(--lg-drop);
  }
  .bottom-nav-container :global(.dock-controls) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    pointer-events: auto;
  }
  .bottom-nav-container[data-theme="dark"] :global(.dock-controls),
  .bottom-nav-container[data-theme="dark"] :global(.dock-social-menu) {
    --lg-glass: rgb(40 40 40 / 0.35);
    --lg-edge: rgb(255 255 255 / 0.14);
    --lg-drop: transparent;
    box-shadow:
      inset 0 0 0 0.5px var(--lg-edge),
      0 8px 24px rgb(0 0 0 / 0.35);
  }
  /* La lente profunda es solo del dock: las piezas internas (lente de la pestaña,
     botón social) vuelven a la geometría por defecto para no deformar los iconos. */
  .bottom-nav-container :global(.lg-tab-bar),
  .bottom-nav-container :global(.dock-social) {
    --lg-bezel: initial;
    --lg-thickness: initial;
    --lg-refraction: initial;
    --lg-rim-saturation: initial;
  }
  .bottom-nav-container :global(.lg-tab-bar) {
    --lg-tab-width: 43px;
    --lg-tab-height: 40px;
    --lg-lens-grow-x: 12px;
    --lg-lens-grow-y: 10px;
    padding: 0;
  }
  .bottom-nav-container :global(.lg-tab-bar-glass) {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }
  .bottom-nav-container :global(.lg-tab-lens),
  .bottom-nav-container :global(.lg-tab-tint) {
    top: 0;
    left: 0;
  }
  .bottom-nav-container :global(.dock-separator) {
    width: 1px;
    height: 20px;
    margin: 0 0.25rem;
    background: var(--lg-separator);
  }
  .bottom-nav-container :global(.dock-social > button) {
    background-color: transparent;
    background-image: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }
  .bottom-nav-container :global(.dock-social > button::after) {
    display: none;
  }
  .bottom-nav-container :global(.lg-tab svg),
  .bottom-nav-container :global(.lg-tab-copy svg) {
    width: 20px;
    height: 20px;
  }
  .bottom-nav-container :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bottom-nav-container :global(.dock-social) { position: relative; }
  .bottom-nav-container :global(.dock-social button img) {
    width: 24px;
    height: 24px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bottom-nav-container :global(.dock-social button[aria-expanded="true"] img) {
    transform: rotate(180deg);
  }
  /* El menú sale del dock (portal): un backdrop-filter anidado no ve la página, así que va fuera */
  .bottom-nav-container :global(.dock-social-menu) {
    position: fixed;
    pointer-events: auto;
    min-width: 140px;
    padding: 6px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
  }
  .bottom-nav-container :global(.dock-social-menu a) {
    color: var(--lg-foreground);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
  }
  .bottom-nav-container :global(.dock-social-menu a:hover),
  .bottom-nav-container :global(.dock-social-menu a:focus-visible) {
    background: var(--lg-highlight);
  }
  @media print { .bottom-nav-container { display: none; } }
</style>
