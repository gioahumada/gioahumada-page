    </a>
    
    <div class="separator"></div>
    
    <div class="social-container">
      <button class="nav-item social-trigger" aria-label="Redes Sociales" id="socialTrigger">
        <img src="/logo.png" alt="Perfil" class="profile-photo" />
      </button>
      
      <div class="social-menu" id="socialMenu">
        <a href="https://x.com/Rockjaj" target="_blank" rel="noopener noreferrer" class="social-item">
          <span>𝕏</span>
        </a>
        <a href="https://www.instagram.com/gio.ahumada1/" target="_blank" rel="noopener noreferrer" class="social-item">
          <span>Instagram</span>
        </a>
        <a href="https://www.linkedin.com/in/gioahumada/" target="_blank" rel="noopener noreferrer" class="social-item">
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  import { onPageLoad } from "../lib/spa-lifecycle";

  onPageLoad(() => {
    function setMenuState(open: boolean) {
      const socialMenu = document.getElementById('socialMenu');
      const socialTrigger = document.getElementById('socialTrigger');
      if (!socialMenu || !socialTrigger) return;
      socialMenu.classList.toggle('active', open);
      socialTrigger.classList.toggle('active', open);
    }

    const handleClick = (e: MouseEvent) => {
      const target = e.target as Element;
      const insideTrigger = target.closest('#socialTrigger');
      const insideMenu = target.closest('#socialMenu');

      if (insideTrigger) {
        e.stopPropagation();
        const socialMenu = document.getElementById('socialMenu');
        setMenuState(!socialMenu?.classList.contains('active'));
        return;
      }

      const socialMenu = document.getElementById('socialMenu');
      if (socialMenu?.classList.contains('active') && !insideMenu) {
        setMenuState(false);
      }
    };

    document.addEventListener('click', handleClick);
    return () => document.removeEventListener('click', handleClick);
  });
</script>

<style>
  .bottom-nav-container {
    position: fixed;
    bottom: 2rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
  }

  @supports (-webkit-touch-callout: none) {
    .bottom-nav-container {
      bottom: 0.75rem;
    }
  }

  .glass-dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem; /* Reduced gap */
    padding: 0.5rem 1rem; /* Reduced padding */
    
    /* Improved Liquid Glass Effect */
    background: rgba(255, 255, 255, 0.4); /* More transparent */
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    
    border-radius: 9999px;
    
    /* Refined borders and shadows for glass realism */
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 8px 32px 0 rgba(31, 38, 135, 0.15),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
      
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    color: #4b5563;
    border-radius: 50%;
    transition: background-color 0.2s ease, color 0.2s ease;
    position: relative;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .nav-item:hover {
    color: #000;
    background: rgba(255, 255, 255, 0.3);
  }

  /* Tooltip Styles */
  .tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.9);
    background-color: #000;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-bottom: 0.75rem;
    pointer-events: none;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Triangle for tooltip */
  .tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 4px;
    border-style: solid;
    border-color: #000 transparent transparent transparent;
  }

  .nav-item:hover .tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .nav-item svg {
    /* Smaller icons */
    width: 20px;
    height: 20px;
    stroke-width: 2px;
  }

  .profile-photo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-trigger.active .profile-photo {
    transform: rotate(180deg);
  }

  .separator {
    width: 1px;
    height: 20px;
    background: rgba(0, 0, 0, 0.1);
    margin: 0 0.25rem;
  }

  /* Social Menu Container */
  .social-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* Social Menu Popup */
  .social-menu {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.95);
    margin-bottom: 1rem;
    
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 16px;
    padding: 0.5rem;
    
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 140px;
    
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    
    box-shadow: 
      0 10px 40px -10px rgba(0,0,0,0.2),
      inset 0 0 0 1px rgba(255,255,255,0.2);
  }

  .social-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .social-item {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    color: #333;
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }

  .social-item:hover {
    background: rgba(255, 255, 255, 0.4);
    color: #000;
  }

  /* Dark mode intentionally disabled — navbar always uses light styles */
</style>
