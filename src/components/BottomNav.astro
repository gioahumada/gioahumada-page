---
import GlassNavigation from './GlassNavigation';

interface Props { theme?: 'light' | 'dark'; defer?: boolean }
const { theme = 'light', defer = false } = Astro.props;
---
<div class="bottom-nav-container" data-theme={theme}>
  {defer ? <GlassNavigation pathname={Astro.url.pathname} client:visible /> : <GlassNavigation pathname={Astro.url.pathname} client:load />}
</div>

<style>
  .bottom-nav-container {
    position: fixed;
    bottom: 2rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
  }
  @supports (-webkit-touch-callout: none) {
    .bottom-nav-container { bottom: 0.75rem; }
  }
  .bottom-nav-container :global(.dock-controls) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    --lg-blur: 20px;
    pointer-events: auto;
  }
  .bottom-nav-container :global(.lg-tab-bar) {
    --lg-tab-width: 43px;
    --lg-tab-height: 40px;
    --lg-lens-grow-x: 12px;
    --lg-lens-grow-y: 10px;
    padding: 0;
  }
  .bottom-nav-container :global(.lg-tab-bar-glass) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }
  .bottom-nav-container :global(.lg-tab-lens),
  .bottom-nav-container :global(.lg-tab-tint) {
    top: 0;
    left: 0;
  }
  .bottom-nav-container :global(.dock-separator) {
    width: 1px;
    height: 20px;
    margin: 0 0.25rem;
    background: var(--lg-separator);
  }
  .bottom-nav-container :global(.dock-social > button) {
    background-color: transparent;
    background-image: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }
  .bottom-nav-container :global(.dock-social > button::after) {
    display: none;
  }
  .bottom-nav-container :global(.lg-tab svg),
  .bottom-nav-container :global(.lg-tab-copy svg) {
    width: 20px;
    height: 20px;
  }
  .bottom-nav-container :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bottom-nav-container :global(.dock-social) { position: relative; }
  .bottom-nav-container :global(.dock-social button img) {
    width: 24px;
    height: 24px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bottom-nav-container :global(.dock-social button[aria-expanded="true"] img) {
    transform: rotate(180deg);
  }
  .bottom-nav-container :global(.dock-social-menu) {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    min-width: 140px;
    padding: 6px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
  }
  .bottom-nav-container :global(.dock-social-menu a) {
    color: var(--lg-foreground);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
  }
  .bottom-nav-container :global(.dock-social-menu a:hover),
  .bottom-nav-container :global(.dock-social-menu a:focus-visible) {
    background: var(--lg-highlight);
  }
  @media print { .bottom-nav-container { display: none; } }
</style>
