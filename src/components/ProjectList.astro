---
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');

// Ordenar por fecha
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectsByYear: Record<number, typeof projects> = {};
for (const project of projects) {
  const year = project.data.date.getUTCFullYear();
  (projectsByYear[year] ??= []).push(project);
}
const years = Object.keys(projectsByYear).map(Number).sort((a, b) => b - a);
const monthFormatter = new Intl.DateTimeFormat('es-CL', { month: 'long', timeZone: 'UTC' });
---

<section class="projects-container">
  {years.map((year) => (
    <section class="project-year-group" aria-labelledby={`projects-${year}`}>
      <h3 class="project-year-heading" id={`projects-${year}`}>
        <span class="year-branch" aria-hidden="true"></span>{year}
      </h3>
      <div class="projects-grid">
        {projectsByYear[year].map((project) => (
          <article class:list={["project-card", { "project-card--image": project.data.media.type !== 'video' }]}>
            <a href={`/${project.id}`} class="project-link">
              <div class="project-media">
                {project.data.media.type === 'video' ? (
                  <>
                    <img
                      src={project.data.media.thumbnail}
                      alt={project.data.title}
                      class="thumbnail"
                    />
                    <video
                      class="video-player"
                      poster={project.data.media.thumbnail}
                      muted
                      loop
                      playsinline
                    >
                      <source src={project.data.media.url} type="video/mp4" />
                    </video>
                  </>
                ) : (
                  <img src={project.data.media.url} alt={project.data.title} />
                )}
              </div>
              <div class="project-content">
                <h4>{project.data.title}</h4>
                <p class="project-month">
                  <span class="month-dash" aria-hidden="true">–</span>
                  {monthFormatter.format(project.data.date)}
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}
</section>

<style>
.projects-container {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 4rem;
  padding: 0 1rem;
}

.project-year-group + .project-year-group {
  margin-top: 2rem;
}

.project-year-heading {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin: 0 0 0.75rem;
  color: #555;
  font-size: 1.125rem;
  font-weight: 400;
  line-height: 1.2;
}

.year-branch {
  position: relative;
  flex: none;
  width: 0.45rem;
  height: 1em;
}

.year-branch::before,
.year-branch::after {
  content: '';
  position: absolute;
  left: 0;
}

.year-branch::before {
  top: 0;
  height: 50%;
  border-left: 1px solid #bbb;
}

.year-branch::after {
  top: 50%;
  width: 0.45rem;
  border-top: 1px solid #bbb;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.25rem;
}

.project-card {
  transition: transform 0.3s ease;
}

.project-card:hover {
  transform: translateY(-5px);
}

.project-link {
  text-decoration: none;
  color: inherit;
}

.project-media {
  position: relative;
  padding-top: 56.25%; /* 16:9 Aspect Ratio */
  border-radius: 0.75rem;
  overflow: hidden;
}

.project-media img,
.project-media video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Apple-style shine effect for image-only project cards */
.project-card--image .project-media {
  overflow: hidden;
}

.project-card--image .project-media::after {
  content: '';
  position: absolute;
  top: 0;
  left: -75%;
  width: 55%;
  height: 100%;
  background: linear-gradient(
    100deg,
    transparent 30%,
    rgba(255, 255, 255, 0.28) 50%,
    transparent 70%
  );
  transform: skewX(-15deg);
  transition: left 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 2;
}

.project-card--image:hover .project-media::after {
  left: 150%;
}

.project-card--image .project-media img {
  transition: filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}


.project-content {
  padding: 0.75rem 0;
}

.project-content h4 {
  font-size: 1.0625rem;
  font-weight: 500;
  line-height: 1.15;
  margin-bottom: 0;
}

.project-month {
  color: #777;
  text-transform: capitalize;
  font-size: 0.9375rem;
  line-height: 1.15;
}

.month-dash {
  margin-right: 0.15rem;
  color: #888;
  font-size: 1.25em;
  font-weight: 300;
}

.video-player {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.thumbnail {
  opacity: 1;
  transition: opacity 0.3s ease;
}

.project-card:hover .video-player {
  opacity: 1;
}

.project-card:hover .thumbnail {
  opacity: 0;
}
</style>

<script>
import { onPageLoad } from "../lib/spa-lifecycle";

onPageLoad(() => {
  document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
    const video = card.querySelector('video');
    if (!video) return;

    card.addEventListener('mouseenter', () => {
      video.play();
    });

    card.addEventListener('mouseleave', () => {
      video.pause();
      video.currentTime = 0;
    });
  });
});
</script>