---
import { ClientRouter } from "astro:transitions";
import PageAnimator from "../components/PageAnimator.astro";
import SocialMeta from "../components/SocialMeta.astro";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  pageKey?: string;
}

const {
  title,
  description = "Estudiante de Ingeniería Informática en la PUCV. Conoce mis proyectos de software, desarrollo web y tecnología.",
  pageKey = "default",
} = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? "https://www.gioahumada.cl");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <SocialMeta title={title} description={description} url={shareUrl} />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body data-page={pageKey}>
    <slot />
    <PageAnimator />
  </body>
</html>

<style is:global>
* {
  margin: 0;
  box-sizing: border-box;
}

body {
  color: white;
  background-color: black;
  font-family: var(--font-sans);
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  text-shadow: 0px 0px 6px rgba(0, 0, 0, 0.4);
  width: 100%;
  height: 100vh;
  height: 100dvh;
  display: grid;
  place-items: center;
  overflow-x: hidden;
  margin: 0;
}
</style> 