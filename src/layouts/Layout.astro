---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import PageAnimator from "../components/PageAnimator.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  pageKey?: string;
}

const {
  title,
  description = "Portfolio personal y proyectos",
  pageKey = "default",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="facebook-domain-verification" content="v5fjbgf2k310j4lexa7s2pakkq38ni" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-page={pageKey}>
    <div class="wrapper">
      <Header />
      <slot />
      <Footer />
      <BottomNav />
    </div>
    <PageAnimator />
  </body>
</html>

<style>
  .wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Asegura que el contenido principal ocupe el espacio disponible */
  :global(main) {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Asegura que el footer esté siempre al final */
  :global(footer) {
    margin-top: auto;
  }
</style>

<script>
  import { animate } from "motion";

  // Preload navigation click sound
  const clickSound = new Audio("/sounds/click.wav");
  clickSound.preload = "auto";
  clickSound.volume = 0.1;

  function isNavigationClick(target: EventTarget | null): boolean {
    if (!(target instanceof Element)) return false;
    const link = target.closest("a");
    if (!(link instanceof HTMLAnchorElement)) return false;
    if (!link.href || link.href.startsWith("#")) return false;
    if (link.hasAttribute("download")) return false;
    if (link.target && link.target !== "_self") return false;
    try {
      if (new URL(link.href, location.href).origin !== location.origin) return false;
    } catch {
      return false;
    }
    return true;
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Navigation click sound
    if (isNavigationClick(target) && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey) {
      clickSound.currentTime = 0;
      clickSound.play().catch(() => {});
    }

    // Scale animation
    const scaleTarget = target.closest("a, button, .project-card, .bento-item");
    if (scaleTarget) {
      animate(
        scaleTarget as Element,
        { scale: [1, 0.95, 1] } as any,
        { duration: 0.2, ease: "ease-in-out" } as any
      );
    }
  });
</script>

